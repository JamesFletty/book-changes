# SQLite database file.
# Use a path the Prisma CLI and the Next.js server both open. An absolute path
# is the reliable choice on a hosted machine. For local development this
# relative path is created under prisma/ when you run `npx prisma db push`.
DATABASE_URL="file:./dev.db"

# Auth.js signs the session cookie with this secret. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Required when the app is served behind a proxy or on a public demo URL.
AUTH_TRUST_HOST="true"

# Uploaded documents are stored here and are not served from /public.
# Defaults to ./data/uploads when unset.
UPLOAD_DIR="./data/uploads"
